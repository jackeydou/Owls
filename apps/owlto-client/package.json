{
  "name": "owlto-client",
  "productName": "Owlto",
  "version": "2026.11.1800",
  "description": "Owlto desktop client for AI-assisted workflows.",
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "author": "Owlto",
  "scripts": {
    "build:workspace-deps": "pnpm --filter @owlto/mac-process-limits build",
    "generate:menu-bar-icons": "node scripts/generate-menu-bar-icons.mjs",
    "lint": "cd ../.. && biome check apps/owlto-client packages",
    "format": "cd ../.. && biome format --write apps/owlto-client packages",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test:unit": "pnpm run build:workspace-deps && pnpm run test:admin",
    "test:admin": "pnpm run build && node --experimental-strip-types --test tests/admin/*.test.mjs",
    "test:packaging": "node --test tests/packaging/*.test.mjs",
    "test:desktop": "pnpm run build && electron tests/admin/desktop-smoke.cjs",
    "verify:codex": "node scripts/verify-codex.mjs",
    "verify:claude": "node scripts/verify-claude.mjs",
    "bench:router": "pnpm run build && node scripts/bench-router.mjs",
    "verify:packaged": "node scripts/verify-packaged-runtime.cjs",
    "db:generate:app": "drizzle-kit generate --config drizzle.app.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.app.config.ts --port 4984",
    "postinstall": "electron-builder install-app-deps && electron-rebuild -o better-sqlite3",
    "prestart": "pnpm run build:workspace-deps",
    "start": "electron-vite preview",
    "predev": "pnpm run build:workspace-deps",
    "dev": "node scripts/dev.mjs",
    "dev:unpack": "pnpm run build:unpack && open dist/mac-arm64/Owlto.app",
    "build": "pnpm run typecheck && electron-vite build",
    "build:unpack": "pnpm run build:workspace-deps && pnpm run build && electron-builder --dir --config scripts/electron-builder-config.cjs",
    "build:win": "pnpm run build:workspace-deps && pnpm run build && electron-builder --win --config scripts/electron-builder-config.cjs",
    "build:mac": "node scripts/build-mac.mjs --release",
    "build:mac:debug": "node scripts/build-mac.mjs --debug",
    "build:mac:local": "node scripts/build-mac.mjs --debug --skip-notarize",
    "build:mac:local:install": "node scripts/build-mac.mjs --debug --skip-notarize --install",
    "build:linux": "pnpm run build:workspace-deps && pnpm run build && electron-builder --linux --config scripts/electron-builder-config.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "gpu-lexer": "0.0.6",
    "ms": "^2.1.3",
    "playwright-core": "1.64.1",
    "posthog-node": "5.61.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.0",
    "@floating-ui/react-dom": "^2.1.8",
    "@owlto/mac-process-limits": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@react-scan/vite-plugin-react-scan": "^0.2.7",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "45.2.3",
    "electron-builder": "26.8.2",
    "electron-vite": "^5.0.0",
    "i18next": "^26.0.8",
    "node-abi": "^4.40.0",
    "pele": "^1.13.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^17.0.6",
    "react-scan": "^0.5.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "zustand": "^5.0.9"
  }
}
